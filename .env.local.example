# Copy to .env.local and fill in. Never commit .env.local (it's gitignored).
# Get these from the Supabase MCP connector (get_project_url /
# get_publishable_keys for project amozcnlvfcxzeaukgbjb) or the dashboard:
# Project Settings -> API.

# Public — safe to ship to the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://amozcnlvfcxzeaukgbjb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never send to
# the browser. Used by src/lib/supabase/admin.ts (auth callback linking,
# registration intake, the alerts job).
SUPABASE_SERVICE_ROLE_KEY=
